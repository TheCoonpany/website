---
import ContentLayout from "../../elements/ContentLayout.astro";
import ServiceImg from "../../assets/consultancy.jpg";
import CorkBg from "../../assets/cork.jpg";
import Button from "../../elements/Button.astro";
import { ROUTES } from "../../router";

import type { Locale, LocalesDict } from "../../locales";

interface Props {
  lang: Locale;
  locales: LocalesDict["home"];
}

const { locales, lang } = Astro.props;

const SERVICES = locales.services.services.map((service) => ({
  ...service,
  href: ROUTES[lang][service.urlKey]?.url,
}));
---

<section id="services" class="shape_biggerthan">
  <picture>
    <img src={CorkBg.src} alt="Cork board" loading="lazy" />
  </picture>

  <ContentLayout>
    <div data-parallax>
      <h2>{locales.services.header}</h2>

      <ul>
        {
          SERVICES.map((service) => (
            <li>
              <a
                href={service.href}
                class="service-card"
                data-transition-link
                data-transition-name={service.href.split("/").pop()}
                tabindex={-1}
              >
                <article>
                  <picture>
                    <img src={ServiceImg.src} alt="" loading="lazy" />
                  </picture>
                  <main>
                    <h3>{service.header}</h3>
                    <p>{service.description}</p>
                  </main>

                  <Button text={service.action} wide />
                </article>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </ContentLayout>
</section>

<style is:global lang="scss">
  section#services {
    --_skew: 5rem;
    --_bg: #e7a16e;
    color: #111;

    ul {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
      gap: 1.5rem;
      margin: 0;
      padding: 0;
      z-index: 1;

      article {
        box-shadow: var(--shadow-3);
        padding: 1rem;
        border-radius: 0.75rem;
        height: 100%;
        display: grid;
        grid-template-rows: max-content 1fr max-content;
        background-color: #eee;
        position: relative;
        transition: box-shadow 0.3s;
        cursor: pointer;

        > main {
          height: 100%;
        }

        > picture {
          display: grid;
          place-items: center;

          img {
            width: 10rem;
            aspect-ratio: 1;
            object-fit: cover;
          }
        }
        &:hover,
        &:focus-within {
          box-shadow: var(--shadow-5);
        }
      }
    }
  }
</style>
