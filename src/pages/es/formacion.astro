---
import Layout from "../../layouts/Layout.astro";
import Education_View from "../../views/Education.view.astro";

import { getPageI18n } from "../../helpers/locales";

const { lang, i18n } = getPageI18n(import.meta.url);

const locales = i18n.education;
---

<Layout meta={{ ...locales.meta, url: Astro.url.pathname }} lang={lang}>
  <Education_View locales={locales} />
</Layout>
