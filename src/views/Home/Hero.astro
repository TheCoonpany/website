---
import ContentLayout from "../../elements/ContentLayout.astro";
import Blueprint from "../../assets/blueprint.jpg";

import type { LocalesDict } from "../../locales";
import Image from "../../elements/Image.astro";

interface Props {
  locales: LocalesDict["home"];
}

const { locales } = Astro.props;
---

<section id="hero">
  <Image image={Blueprint} alt="Blueprint" />

  <ContentLayout>
    <div id="hero-content" data-parallax>
      <hgroup>
        <h1>{locales.hero.header}</h1>
        <h2>{locales.hero.subHeader}</h2>
      </hgroup>
      <p>{locales.hero.description}</p>
    </div>
  </ContentLayout>
</section>

<style is:global lang="scss">
  section#hero {
    height: clamp(30rem, calc(50rem - 50dvw), 50rem);
    --_bg: #061f38;

    > picture > img {
      object-position: 60% 20%;
      filter: brightness(0.5);
    }

    [data-el="content-layout"] {
      position: relative;
      height: 100%;
      align-items: flex-end;
      justify-content: flex-end;
    }
  }

  #hero-content {
    color: #ddd;
    padding: 1rem 2rem;
    border-radius: 0.75rem;
    box-shadow: 0 0 100px rgba(0, 0, 0, 0.6);
    background-color: rgba(0, 0, 0, 0.6);
    max-width: 35rem;

    :is(h1, h2) {
      margin-block: 0.5rem;
    }
    h1 {
      font-size: 2.5rem;
    }
    h2 {
      font-size: 1.5rem;
      font-weight: normal;
      margin-top: 0.25rem;
    }
    p {
      font-size: 1rem;
      margin-top: 1rem;
    }
  }
</style>
