---
import Legal_View from "../../views/Legal.view.astro";
import Layout from "../../layouts/Layout.astro";

import { getPageI18n } from "../../helpers/locales";

const { lang, i18n } = getPageI18n(import.meta.url);

const locales = i18n.privacy_policy;
---

<Layout meta={{ ...locales.meta, url: Astro.url.pathname }} lang={lang}>
  <Legal_View locales={locales} />
</Layout>
