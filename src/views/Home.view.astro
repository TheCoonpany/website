---
import ContentLayout from "../components/ContentLayout.astro";
import Blueprint from "../assets/blueprint.jpg";

import type { LocalesDict } from "../locales/_def.types";

interface Props {
  locales: LocalesDict["home"];
}

const { locales } = Astro.props;
---

<div>
  <main data-current-page="home" transition:name="home">
    <section id="banner">
      <picture>
        <img src={Blueprint.src} alt="Logo" />
      </picture>
      <ContentLayout>
        <div id="banner-content">
          <h1>Home</h1>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        </div>
      </ContentLayout>
    </section>
  </main>
</div>

<div data-page transition:name="consultancy"></div>
<div data-page transition:name="development"></div>
<div data-page transition:name="education"></div>

<style lang="scss">
  #banner {
    position: relative;
    width: 100%;
    height: 20rem;
    // max-width: 50rem;
    // place-items: center;
    // align-content: center;
    // margin-inline: auto;

    > picture {
      position: absolute;
      inset: 0;
      overflow: hidden;
      //   width: 100%;
      //   height: 100%;
      //   inset: 0;
      //   z-index: -1;

      > img {
        object-fit: cover;
        width: 100%;
        height: 100%;
        object-position: 60% center;
        filter: brightness(0.5);
      }
    }

    #banner-content {
      position: absolute;
      top: 50%;
      color: white;
      padding: 1rem 3rem;
      box-shadow: 0 0 100px rgba(0, 0, 0, 0.5);
      background-color: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(0.5);
    }
  }
</style>
