---
import { objectKeys } from "../_shared/helpers";
import type { Icon_Name } from "../elements/Icon";
import Icon from "../elements/Icon.astro";
import type { Nav_Entry } from "../helpers/sitemap";

interface Props {
  links: readonly {
    name: string;
    page: Nav_Entry;
    href: string;
  }[];
}

const { links } = Astro.props;

const HEADER_ICONS = {
  consultancy: "consultancy",
  development: "terminal",
  education: "education",
  about_us: "clip",
} as const satisfies Partial<Record<Nav_Entry, Icon_Name>>;

const HEADER_LINKS = objectKeys(HEADER_ICONS).map((key) => {
  const entry = links.find((link) => link.page === key);
  if (!entry) throw new Error(`No entry found for page "${key}"`);
  return {
    ...entry,
    page: key,
    icon: HEADER_ICONS[key],
  };
});
---

<ul id="folder-links">
  {
    HEADER_LINKS.map(({ name, page, href, icon }, i) => (
      <li data-to={page} style={{ "--item": i }}>
        <a href={href} title={name} aria-label={name}>
          <Icon icon={icon} />
          <span>{name}</span>
        </a>
      </li>
    ))
  }
</ul>

<style lang="scss">
  @use "./AppHeader.FolderLinks.scss" as *;

  $bg: #f4e3c3;
  $anim: 0.3s;

  ul#folder-links {
    --step: 0.5rem;
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    height: 100%;
    padding-inline: 0.5rem;
    justify-self: flex-end;

    li {
      position: relative;
      margin-right: -1rem;
      height: 100%;
      display: inline-block;
      overflow-y: clip;

      a {
        --icon_size: 1.25rem;
        position: relative;
        display: grid;
        font-size: 1rem;
        place-items: center;
        grid-template-columns: max-content max-content;
        background-color: $bg;
        padding: 0.75rem 1.75rem 3rem;
        border-radius: 0.75rem 0.75rem 0 0;
        color: #111;
        transform: translatey(calc(1.2rem + (var(--item) * var(--step))));
        box-shadow: var(--shadow-3);
        transition:
          transform $anim ease-in-out,
          rotate $anim ease-in-out,
          color $anim ease,
          box-shadow $anim ease;

        span {
          display: inline-block;
          alignment-baseline: central;
          padding-top: 0.3rem;
        }

        &::after,
        &::before {
          content: "";
          position: absolute;
          display: inline-block;
          transition: transform $anim ease-in-out;
          box-shadow: var(--shadow-5);
        }

        &::after {
          top: 2.75rem;
          height: 4rem;
          width: 50rem;
          border-top-left-radius: 0.5rem;
          border-top-right-radius: 0.5rem;
          right: -0.5rem;
          background-color: $bg;
          transform-origin: 50% 100%;
        }
        &::before {
          width: 1.5rem;
          left: 0;
          height: 5rem;
          top: 3rem;
          background-color: #b02727;
          clip-path: polygon(0% 0%, 50% 5%, 100% 0%, 100% 100%, 0 100%);
        }
      }

      @each $service, $deg in $services {
        &[data-to="#{$service}"] a {
          rotate: $deg;
        }
      }
    }
  }
</style>

<style is:global lang="scss">
  @use "./AppHeader.FolderLinks.scss" as *;

  header#app-header {
    @each $service, $deg in $services {
      &:has(~ #app-content [data-current-page="#{$service}"])
        [data-to="#{$service}"]
        a,
      #folder-links [data-to] a:focus,
      #folder-links [data-to] a:hover {
        color: #222;
        rotate: -0.2deg !important;
        transform: translatey(calc(0.25rem + (var(--item) * var(--step))));
        box-shadow: var(--shadow-5);
        outline: none;

        &::after {
          transform: rotateX(45deg);
        }
        &::before {
          transform: translatey(-1.5rem) rotatez(-10deg);
        }
      }
    }

    ul#folder-links {
      [data-el="icon"] {
        margin-right: 0.5rem;
      }
      @media screen and (width < 1000px) {
        [data-el="icon"] {
          display: none;
        }
      }

      @media screen and (width < 900px) {
        a {
          font-size: 0.9rem;
        }
      }

      @media screen and (width < 700px) {
        li {
          margin-right: -0.5rem;
        }
        [data-el="icon"] {
          --icon_size: 1.5rem;
          display: unset;
          margin-right: 0;
        }
        span {
          display: none;
        }
      }

      @media screen and (width < 460px) {
        a {
          padding-inline: 1.25rem;
        }
      }
    }
  }
</style>
