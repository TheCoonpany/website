---
import ContentLayout from "../elements/ContentLayout.astro";
import FolderLinks from "./AppHeader.FolderLinks.astro";
import Img from "../assets/raccoon_3.png";
import * as LOCALES from "../locales";

import { AVAILABLE_LOCALES, type Locale } from "../locales";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const locales = LOCALES[lang].app.header;

function localizeLang(value: Locale) {
  const transLang = new Intl.DisplayNames(lang, {
    type: "language",
  }).of(value);
  return `${locales.switchLang} ${transLang}`;
}
---

<header id="app-header">
  <div class="bg"></div>
  <ContentLayout>
    <nav>
      <a id="logo" title="The Coonpany" href={`/${lang}`}>
        <img src={Img.src} alt="The Coonpany" />
        <span>The Coonpany</span>
      </a>

      <FolderLinks lang={lang} />

      <ul id="lang-selector">
        {
          AVAILABLE_LOCALES.map((locale) => (
            <li>
              <a
                tabindex={locale === lang ? -1 : undefined}
                href={`/${locale}`}
                title={localizeLang(locale)}
                aria-label={localizeLang(locale)}
                aria-current={locale === lang || undefined}
              >
                {locale.toUpperCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </ContentLayout>
</header>

<style is:global lang="scss">
  $height: 4.5rem;
  $skew: var(--header-skew);
  $anim: 0.2s;

  header#app-header {
    --_margins: 1.5rem;
    inset-inline: 0;
    z-index: 100;
    position: relative;
    clip-path: polygon(0% calc(100% - #{$skew}), 0% 0%, 100% 0, 100% 100%);

    > div.bg {
      position: absolute;
      display: inline-block;
      background-color: #111;
      inset: 0;
    }

    * {
      user-select: none;
    }

    nav {
      display: grid;
      grid-template-columns: max-content 1fr max-content;
      align-items: flex-start;
      width: 100%;
      height: calc($height + #{$skew});
      justify-content: space-between;
      color: #ddd;
      z-index: 101;
      padding-top: 0.5rem;
    }

    #logo,
    #lang-selector {
      margin-bottom: #{$skew};
    }

    #logo {
      margin-right: var(--_margins);
      display: grid;
      grid-template-columns: repeat(2, max-content);
      align-items: center;

      img {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        transition:
          outline $anim,
          box-shadow $anim;
      }
      span {
        margin-top: 0.3em;
        font-size: 1.5rem;
        padding: 0.5rem;
        transition:
          color $anim,
          text-shadow $anim;
      }
      &:focus {
        outline: none;

        img {
          outline: 2px solid var(--neon_blue);
          box-shadow: 0 0 10px var(--neon_blue);
        }
        span {
          color: var(--neon_blue);
          text-shadow: 0 0 10px var(--neon_blue);
        }
      }
    }

    #lang-selector {
      margin: 0 0 0 var(--_margins);
      font-size: 1.25rem;
      padding: 0.5rem;
      display: grid;
      gap: 0.5rem;
      list-style-type: none;

      a {
        transition:
          color $anim,
          text-shadow $anim;

        &[aria-current] {
          pointer-events: none;
          color: #888;
        }
        &:focus {
          outline: none;
          color: var(--neon_blue);
          text-shadow: 0 0 10px var(--neon_blue);
        }
      }
      li + li {
        border-top: 2px solid #ddd;
        padding-top: 0.5rem;
      }
    }

    @media screen and (width < 1200px) {
      #logo span {
        font-size: 1.25rem;
      }
      #lang-selector {
        font-size: 1rem;
      }
    }

    @media screen and (width < 900px) {
      --_margins: 1rem;
    }

    @media screen and (width < 800px) {
      #logo span {
        display: none;
      }
    }

    @media screen and (width < 700px) {
      #logo span {
        display: inline;
      }
    }

    @media screen and (width < 600px) {
      #logo span {
        display: none;
      }
    }

    @media screen and (width < 400px) {
      --_margins: 0.5rem;
    }
  }
</style>
