---
import { ClientRouter } from "astro:transitions";

import AppHeader from "../components/AppHeader.astro";
import AppFooter from "../components/AppFooter.astro";

import "../styles/colors.scss";
import "../styles/shadows.scss";
import "../styles/fonts.scss";
import "../styles/navigation.scss";

import type { Page_Meta } from "../locales/_def.types";
import type { Locale } from "../helpers/locales";

interface Props {
	meta: Page_Meta & { url: string };
	lang: Locale;
}

const { meta, lang } = Astro.props;

const SITE_URL = Astro.site?.toString().replace(/\/$/, "") || "";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{meta.title}</title>
		<meta name="description" content={meta.description} />
		{
			meta.keywords && (
				<meta name="keywords" content={meta.keywords?.join(", ")} />
			)
		}
		<link rel="canonical" href={`${SITE_URL}${meta.url}`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Play:wght@400;700&family=Special+Elite&display=swap"
			rel="stylesheet"
		/>

		<ClientRouter />
	</head>

	<body>
		<AppHeader lang={lang} />
		<main id="app-content">
			<div>
				<slot />
			</div>
			<AppFooter />
		</main>
	</body>
</html>

<style lang="scss">
	#app-content {
		overflow: hidden scroll;
		display: grid;
		grid-template-rows: 1fr max-content;
		min-height: 100%;
	}
</style>

<style is:global lang="scss">
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		overflow: hidden;
		background-color: #e3e0d5;
		color: #222;
		font-family: var(--f-font);
		display: grid;
		grid-template-rows: max-content 1fr;
		height: 100dvh;
		min-width: 360px;

		&:has(#wip) :is(#app-header, #app-footer) {
			display: none;
		}
	}

	* {
		box-sizing: border-box;
	}
</style>
