---
import Icon from "../elements/Icon.astro";
import type { Locale } from "../locales";
import { HEADER_LINKS } from "./AppHeader.FolderLinks.content";

interface Props {
  lang: Locale;
}
---

<ul id="folder-links">
  {
    HEADER_LINKS(Astro.props.lang).map(({ name, page, href, icon }, i) => (
      <li data-to={page} style={{ "--item": i }}>
        <a href={href} title={name} aria-label={name}>
          <Icon icon={icon} />
          <span>{name}</span>
        </a>
      </li>
    ))
  }
</ul>

<style lang="scss">
  @use "./AppHeader.FolderLinks.scss" as *;
  @use "sass:map";

  $bg: #f4e3c3;
  $anim: 0.3s;

  ul#folder-links {
    --step: 0.5rem;
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    height: 100%;
    padding-inline: 0.5rem;
    justify-self: flex-end;
    // clip-path: var(--_clip-path);

    li {
      position: relative;
      margin-right: -1rem;
      height: 100%;
      display: inline-block;
      // overflow-y: clip;

      a {
        --icon_size: 1.25rem;
        position: relative;
        display: grid;
        font-size: 1rem;
        place-items: center;
        grid-template-columns: max-content max-content;
        background-color: $bg;
        padding: 0.75rem 1.75rem 3rem;
        border-radius: 0.75rem 0.75rem 0 0;
        color: #111;
        transform: translatey(calc(1.2rem + (var(--item) * var(--step))));
        box-shadow: var(--shadow-3);
        transition:
          transform $anim ease-in-out,
          rotate $anim ease-in-out,
          color $anim ease,
          box-shadow $anim ease;

        span {
          display: inline-block;
          alignment-baseline: central;
          padding-top: 0.3rem;
        }

        &::after,
        &::before {
          content: "";
          position: absolute;
          display: inline-block;
          transition: transform $anim ease-in-out;
        }

        &::after {
          top: 2.75rem;
          height: 4rem;
          width: 50rem;
          border-top-left-radius: 0.5rem;
          border-top-right-radius: 0.5rem;
          right: -0.5rem;
          background-color: $bg;
          transform-origin: 50% 100%;
          box-shadow: var(--shadow-5);
          z-index: 100;
        }
        &::before {
          width: 1.5rem;
          left: 0;
          height: 5rem;
          top: 3rem;
          background-color: var(--_label-bg, black);
          box-shadow: var(--shadow-2);
          clip-path: polygon(0% 0%, 50% 5%, 100% 0%, 100% 100%, 0 100%);
          transform-origin: 50% 100%;
        }
      }

      @each $service, $data in $services {
        &[data-to="#{$service}"] a {
          --_label-bg: #{map.get($data, "label")};
          rotate: map.get($data, "rad");
        }
      }
    }
  }
</style>

<style is:global lang="scss">
  @use "./AppHeader.FolderLinks.scss" as *;

  header#app-header {
    @each $service, $data in $services {
      &:has(~ #app-content [data-current-page="#{$service}"])
        [data-to="#{$service}"]
        a,
      #folder-links [data-to] a:focus,
      #folder-links [data-to] a:hover {
        color: #222;
        rotate: -0.2deg !important;
        transform: translatey(calc(0.25rem + (var(--item) * var(--step))));
        box-shadow: var(--shadow-5);
        outline: none;

        &::after {
          transform: rotateX(45deg);
        }
        &::before {
          animation: marker 1s linear forwards;
        }
      }
    }

    ul#folder-links {
      [data-el="icon"] {
        margin-right: 0.5rem;
      }
      @media screen and (width < 1000px) {
        [data-el="icon"] {
          display: none;
        }
      }

      @media screen and (width < 900px) {
        a {
          font-size: 0.9rem;
        }
      }

      @media screen and (width < 700px) {
        li {
          margin-right: -0.5rem;
        }
        [data-el="icon"] {
          --icon_size: 1.5rem;
          display: unset;
          margin-right: 0;
        }
        span {
          display: none;
        }
      }

      @media screen and (width < 460px) {
        a {
          padding-inline: 1.25rem;
        }
      }
    }
  }

  @keyframes marker {
    50% {
      transform: translatey(-1.5rem) rotate(-5deg);
    }
    75% {
      transform: translatey(-1.5rem rotate(-5deg));
      // z-index: 101;
    }
    // 100% {
    //   transform: rotateX(180deg);
    // }
    100% {
      transform: translatey(-1.5rem) rotate(-5deg);
      // z-index: 101;s
    }
  }
</style>
