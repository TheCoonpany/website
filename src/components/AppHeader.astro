---
import { NAV_LABELS } from "../helpers/sitemap";
import ContentLayout from "./ContentLayout.astro";
import FolderLink from "./AppHeader.FolderLink.astro";

import type { Locale } from "../helpers/locales";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<header id="app-header">
  <ContentLayout>
    <nav>
      <div id="logo">
        <a href={`/${lang}`}>The Coonpany</a>
      </div>

      <ul>
        {
          Object.entries(NAV_LABELS[lang]).map(([id, value]) => (
            <FolderLink page={id} name={value.label} href={value.url} />
          ))
        }
      </ul>

      <a href={`/${lang === "es" ? "en" : "es"}`}>
        {lang === "es" ? "EN" : "ES"}
      </a>
    </nav>
  </ContentLayout>
</header>

<style lang="scss">
  header#app-header {
    background-color: #111;
    inset-inline: 0;

    nav {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      align-items: center;
      width: 100%;
      height: 3.5rem;
      justify-content: space-between;

      > ul {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        height: 100%;
        padding-inline: 2rem 1rem;
        overflow: clip;
      }
    }

    a {
      color: #ddd;
      text-decoration: none;
    }

    #logo {
      a {
        font-size: 1.5rem;
        padding: 0.5rem;
      }
    }
  }
</style>
