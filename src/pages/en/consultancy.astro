---
import Layout from "../../layouts/Layout.astro";
import Consultancy_View from "../../views/Consultancy.view.astro";

import { getPageI18n } from "../../helpers/locales";

const i18n = getPageI18n(import.meta.url, "consultancy");
---

<Layout
  meta={{ ...i18n.locales.meta, url: Astro.url.pathname }}
  lang={i18n.lang}
>
  <Consultancy_View {...i18n} />
</Layout>
