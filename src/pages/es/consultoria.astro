---
import Layout from "../../layouts/Layout.astro";
import Consultancy_View from "../../views/Consultancy.view.astro";

import { getPageI18n } from "../../helpers/locales";

const { lang, i18n } = getPageI18n(import.meta.url);

const locales = i18n.consultancy;
---

<Layout meta={{ ...locales.meta, url: Astro.url.pathname }} lang={lang}>
  <Consultancy_View locales={locales} />
</Layout>
