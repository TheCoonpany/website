---
import ContentLayout from "../elements/ContentLayout.astro";
import Img from "../assets/raccoon_3.png";
---

<main id="wip">
	<ContentLayout>
		<main>
			<h1>The<br />Coonpany</h1>
			<picture>
				<img src={Img.src} alt="Logo" />
			</picture>
			<div>
				<div>
					{Array.from({ length: 10 }, () => <h3>Site under coonstruction</h3>)}
				</div>
			</div>
		</main>
	</ContentLayout>
</main>

<style lang="scss">
	main {
		position: relative;
		display: grid;
		height: 100%;
		max-width: 50rem;
		place-items: center;
		align-content: center;
		margin-inline: auto;
		grid-auto-columns: 1fr;

		> h1 {
			font-size: 5rem;
			text-align: center;
		}

		> div {
			background-color: var(--color_warning);
			width: 300dvw;
			height: 5rem;
			position: fixed;
			transform-origin: center;
			rotate: -12deg;
			bottom: 15dvh;

			border: 10px solid pink;
			border-image: repeating-linear-gradient(
					-55deg,
					#000,
					#000 20px,
					var(--color_warning) 20px,
					var(--color_warning) 40px
				)
				10;

			> div {
				text-align: center;
				display: grid;
				grid-auto-flow: column;
				align-items: center;
				justify-content: center;
				height: 100%;
				white-space: nowrap;

				h3 {
					display: inline-block;
					margin-left: 1rem;
					&::before {
						content: "~";
						margin-right: 1rem;
					}
				}
			}
		}

		picture {
			width: 100%;
		}

		img {
			aspect-ratio: 1;
			object-fit: contain;
			margin-bottom: 10rem;
			border-radius: 50%;
		}
	}
</style>
