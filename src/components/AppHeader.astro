---
import { NAV_LABELS } from "../helpers/sitemap";
import ContentLayout from "../elements/ContentLayout.astro";
import FolderLinks from "./AppHeader.FolderLinks.astro";
import Img from "../assets/raccoon_3.png";
import * as LOCALES from "../locales";

import type { Locale } from "../helpers/locales";
import { objectEntries } from "../_shared/helpers";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const locales = LOCALES[lang].app.header;

const entries = objectEntries(NAV_LABELS[lang]).map(([page, value]) => ({
  page,
  name: value.label,
  href: value.url,
}));
---

<header id="app-header">
  <ContentLayout>
    <nav>
      <a id="logo" title="The Coonpany" href={`/${lang}`}>
        <img src={Img.src} alt="The Coonpany" />
        <span>The Coonpany</span>
      </a>

      <FolderLinks links={entries} />

      <div id="lang-selector">
        <a
          href={`/${lang === "es" ? "en" : "es"}`}
          title={locales.switchLang}
          aria-label={locales.switchLang}
        >
          {lang === "es" ? "EN" : "ES"}
        </a>
      </div>
    </nav>
  </ContentLayout>
</header>

<style lang="scss">
  header#app-header {
    background-color: #111;
    inset-inline: 0;

    nav {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      align-items: center;
      width: 100%;
      height: 3.5rem;
      justify-content: space-between;
    }

    #logo {
      margin-right: 1.5rem;
      display: grid;
      grid-template-columns: repeat(2, max-content);
      align-items: center;

      img {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
      }
      span {
        margin-top: 0.3em;
        font-size: 1.5rem;
        padding: 0.5rem;
      }

      @media screen and (width < 1200px) {
        span {
          font-size: 1.25rem;
        }
      }

      @media screen and (width < 900px) {
        margin-right: 0.5rem;

        span {
          display: none;
        }
      }
    }

    #lang-selector {
      margin-left: 1.5rem;
      margin-top: 0.3em;
      font-size: 1.25rem;
      padding: 0.5rem;

      @media screen and (width < 1200px) {
        font-size: 1rem;
      }

      @media screen and (width < 900px) {
        margin-left: 0.5rem;
      }
    }
  }
</style>
