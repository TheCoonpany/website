---
interface Props {
  text?: string;
}

const $props = Astro.props;
---

<button data-el="button">
  <span>
    <slot>{$props.text}</slot>
  </span>
</button>

<style lang="scss">
  button[data-el="button"] {
    --_color: var(--button__color, #ddd);
    position: relative;
    cursor: pointer;
    width: max-content;
    border-radius: 0.25rem;

    color: var(--_color);
    padding: 0;
    border: none;
    background-color: #0b3460;
    transition: all 0.3s ease;
    border: 2px solid #0b3460;

    &,
    > span {
      &:before,
      &:after {
        position: absolute;
        content: "";
        background: var(--_color);
        box-shadow: 0 0 0 var(--_color);
        transition: all 0.3s ease;
      }
    }

    &:focus {
      --_color: #f88c07;
      outline: none;
    }

    &:focus,
    &:hover {
      background-color: #104884;
      border-color: #104884;
    }

    &:focus,
    &:hover {
      &,
      > span {
        &:before {
          height: 100%;
        }
        &:after {
          width: 100%;
        }
      }
    }

    > span {
      position: relative;
      display: block;
      padding: 0.5rem 1rem;
      width: 100%;
      height: 100%;

      &:before,
      &:after {
        left: 0;
        top: 0;
      }
      &:before {
        width: 2px;
        height: 50%;
      }
      &:after {
        height: 2px;
        width: 20%;
      }
    }

    &:before,
    &:after {
      right: 0;
      bottom: 0;
    }
    &:before {
      height: 50%;
      width: 2px;
    }
    &:after {
      width: 20%;
      height: 2px;
    }
  }
</style>
