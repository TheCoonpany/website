---
interface Props {
  text?: string;
}

const $props = Astro.props;
---

<button data-el="button">
  <span>
    <slot>{$props.text}</slot>
  </span>
</button>

<style lang="scss">
  button[data-el="button"] {
    --_color: var(--button__color, #ddd);
    --_bg: var(--button__bg, #0b3460);
    --_stoke: 2px;
    position: relative;
    cursor: pointer;
    width: max-content;
    border-radius: 0.25rem;

    color: var(--_color);
    padding: 0;
    border: none;
    background-color: var(--_bg);
    transition: all 0.3s ease;
    border: 2px solid var(--_bg);

    &,
    > span {
      &:before,
      &:after {
        position: absolute;
        content: "";
        background: var(--_color);
        box-shadow: 0 0 0 var(--_color);
        transition: all 0.3s ease;
      }
    }

    &:focus {
      --_color: var(--neon_blue);
      outline: none;
    }

    > span {
      position: relative;
      display: block;
      padding: 0.5rem 1rem;
      width: 100%;
      height: 100%;

      &:before,
      &:after {
        left: 0;
        top: 0;
      }
      &:before {
        width: var(--_stoke);
        height: 50%;
      }
      &:after {
        height: var(--_stoke);
        width: 20%;
      }
    }

    &:before,
    &:after {
      right: 0;
      bottom: 0;
    }
    &:before {
      height: 50%;
      width: var(--_stoke);
    }
    &:after {
      width: 20%;
      height: var(--_stoke);
    }
  }
</style>

<style is:global lang="scss">
  :is(
    button[data-el="button"]:hover,
    button[data-el="button"]:focus,
    :is(a:hover, a:focus) button[data-el="button"]
  ) {
    --_bg: #104884 !important;
    &,
    > span {
      &:before {
        height: 100% !important;
      }
      &:after {
        width: 100% !important;
      }
    }
  }
</style>
