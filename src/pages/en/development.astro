---
import Layout from "../../layouts/Layout.astro";
import Development_View from "../../views/Development/_.view.astro";

import { getPageI18n } from "../../helpers/locales";

const i18n = getPageI18n(import.meta.url, "development");
---

<Layout
  meta={{ ...i18n.locales.meta, url: Astro.url.pathname }}
  lang={i18n.lang}
>
  <Development_View {...i18n} />
</Layout>
