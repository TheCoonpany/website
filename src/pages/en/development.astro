---
import Layout from "../../layouts/Layout.astro";
import Development_View from "../../views/Development.view.astro";

import { getPageI18n } from "../../helpers/locales";

const { lang, i18n } = getPageI18n(import.meta.url);

const locales = i18n.development;
---

<Layout meta={{ ...locales.meta, url: Astro.url.pathname }} lang={lang}>
  <Development_View locales={locales} />
</Layout>
