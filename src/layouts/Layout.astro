---
import { ClientRouter } from "astro:transitions";

import AppHeader from "../components/AppHeader.astro";
import AppFooter from "../components/AppFooter.astro";

import "../styles/index.scss";
import "./Layout.scss";

import type { PageI18n_Props } from "../locales/helpers.types";
import type { Route } from "../router.types";

interface Props extends PageI18n_Props<Route> {}

const { meta, lang } = Astro.props;

const SITE_URL = Astro.site?.toString().replace(/\/$/, "") || "";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{meta.title}</title>
		<meta name="description" content={meta.description} />
		{
			meta.keywords && (
				<meta name="keywords" content={meta.keywords?.join(", ")} />
			)
		}
		<link rel="canonical" href={`${SITE_URL}${meta.url}`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Play:wght@400;700&family=Special+Elite&display=swap"
			rel="stylesheet"
		/>

		<ClientRouter />
	</head>

	<body>
		<AppHeader lang={lang} />
		<main id="app-content">
			<div>
				<slot />
			</div>
			<AppFooter lang={lang} />
		</main>
	</body>
</html>

<style lang="scss">
	#app-content {
		overflow: hidden scroll;
		display: grid;
		position: relative;
		grid-template-rows: 1fr max-content;
		min-width: 100dvw;
		scrollbar-color: #e2ff62 #333;
		scrollbar-width: thin;
		box-sizing: content-box;
		margin-top: calc(var(--header-skew) * -1);

		&:has(#wip) {
			overflow: hidden;
		}

		> div {
			display: grid;
			grid-auto-flow: column;
		}
	}
</style>

<script src="./Layout.ts"></script>
