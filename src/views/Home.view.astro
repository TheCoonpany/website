---
import ContentLayout from "../elements/ContentLayout.astro";
import Blueprint from "../assets/blueprint.jpg";

import type { LocalesDict } from "../locales/_def.types";

interface Props {
  locales: LocalesDict["home"];
}

const { locales } = Astro.props;
---

<div>
  <main data-current-page="home" transition:name="home">
    <section id="hero">
      <picture>
        <img src={Blueprint.src} alt="Logo" />
      </picture>
      <ContentLayout>
        <div id="hero-content">
          <hgroup>
            <h1>{locales.hero.header}</h1>
            <h2>{locales.hero.subHeader}</h2>
          </hgroup>
          <p>{locales.hero.description}</p>
        </div>
      </ContentLayout>
    </section>
  </main>
</div>

<div data-page transition:name="consultancy"></div>
<div data-page transition:name="development"></div>
<div data-page transition:name="education"></div>
<div data-page transition:name="about_us"></div>

<style lang="scss">
  #hero {
    position: relative;
    width: 100%;
    height: 20rem;

    > picture {
      position: absolute;
      inset: 0;
      overflow: hidden;
      > img {
        object-fit: cover;
        width: 100%;
        height: 100%;
        object-position: 60% center;
        filter: brightness(0.5);
      }
    }

    #hero-content {
      color: white;
      padding: 1rem 3rem;
      border-radius: 0.25rem;
      box-shadow: 0 0 100px rgba(0, 0, 0, 0.5);
      background-color: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(0.5);
      max-width: 35rem;

      :is(h1, h2) {
        margin-block: 0.5rem;
      }
      h1 {
        font-size: 2.5rem;
      }
      h2 {
        font-size: 1.5rem;
        font-weight: normal;
        margin-top: 0.25rem;
      }
      p {
        font-size: 1rem;
        margin-top: 1rem;
      }
    }
  }
</style>

<style is:global lang="scss">
  #hero {
    [data-el="content-layout"] {
      position: relative;
      height: 100%;
      align-items: flex-end;
      padding-bottom: 1rem;
    }
  }
</style>
