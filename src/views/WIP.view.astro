---
import ContentLayout from "../elements/ContentLayout.astro";
import Img from "../../public/logos/TheCoonpany.png";
import Image from "../elements/Image.astro";
import Isotype from "../../public/logos/isotype.svg";
---

<main id="wip">
	<ContentLayout>
		<main>
			<Isotype />
			<Image image={Img} alt="Logo" />
			<div>
				<div>
					{Array.from({ length: 10 }, () => <h3>Site under coonstruction</h3>)}
				</div>
			</div>
		</main>
	</ContentLayout>
</main>

<style lang="scss">
	main {
		position: relative;
		display: grid;
		height: 100dvh;
		place-items: center;
		align-content: center;
		margin-inline: auto;
		grid-auto-columns: 1fr;
		gap: clamp(0.5rem, 2dvw, 4rem);

		> div {
			background-color: var(--color_warning);
			width: 300dvw;
			height: 5rem;
			position: fixed;
			transform-origin: center;
			rotate: -12deg;
			bottom: 15dvh;

			border: 10px solid pink;
			border-image: repeating-linear-gradient(
					-55deg,
					#000,
					#000 1.5rem,
					var(--color_warning) 1.5rem,
					var(--color_warning) 2.5rem
				)
				10;

			> div {
				text-align: center;
				display: grid;
				grid-auto-flow: column;
				align-items: center;
				justify-content: center;
				height: 100%;
				white-space: nowrap;

				h3 {
					display: inline-block;
					margin-left: 1rem;
					&::before {
						content: "~";
						margin-right: 1rem;
					}
				}
			}
		}
	}
</style>

<style is:global lang="scss">
	main#wip {
		picture {
			width: 100%;

			img {
				aspect-ratio: 1;
				object-fit: contain;
				width: 100%;
				max-width: 50rem;
			}
		}
	}
</style>
