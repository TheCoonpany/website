---
import Home_View from "../../views/Home/_.view.astro";
import Layout from "../../layouts/Layout.astro";

import { getPageI18n } from "../../helpers/locales";

const i18n = getPageI18n(import.meta.url, "home");
---

<Layout
	meta={{ ...i18n.locales.meta, url: Astro.url.pathname }}
	lang={i18n.lang}
>
	<Home_View {...i18n} />
</Layout>
