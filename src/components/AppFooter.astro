---
import AstroLogo from "../assets/astro_logo.svg";
import Icon from "../elements/Icon.astro";
import ContentLayout from "../elements/ContentLayout.astro";
import * as LOCALES from "../locales";

import type { Locale } from "../helpers/locales";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const locales = LOCALES[lang].app.footer;
---

<footer id="app-footer">
  <ContentLayout>
    <nav>
      <p id="company">The Coonpany | {new Date().getFullYear()}</p>

      <a href="https://astro.build/" target="_blank" id="made-with-astro">
        <span>{locales.madeWith}</span>
        <img src={AstroLogo.src} alt="Astro logo" />
        <span>Astro</span>
      </a>

      <ul id="social">
        <li>
          <a href="https://github.com/TheCoonpany" target="_black">
            <Icon icon="github" />
          </a>
          <li></li>
          <a
            href="https://www.linkedin.com/company/the-coonpany"
            target="_black"
          >
            <Icon icon="linkedin" />
          </a>
          <li></li>
          <a href="mailto:info@thecoonpany.dev" target="_black">
            <Icon icon="mail" />
          </a>
        </li>
      </ul>
    </nav>
  </ContentLayout>
</footer>

<style lang="scss">
  footer#app-footer {
    background-color: #111;
    min-height: 3.5rem;
    inset-inline: 0;
    padding-block: 0.5rem;

    nav {
      color: #ddd;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      justify-content: space-between;
      align-items: center;

      #company {
        font-size: 0.9rem;
      }

      #made-with-astro {
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 0.5ch;
        img {
          width: 1em;
          height: 1em;
        }
      }

      a {
        text-decoration: none;
        color: #ddd;
      }

      #social {
        list-style: none;
        display: flex;
        flex-direction: row;
        margin: 0;
        padding: 0;
        gap: 0.25rem;

        a {
          color: #ddd;
          text-decoration: none;
          --icon_size: 2rem;
        }
      }

      @media screen and (width < 900px) {
        #made-with-astro {
          font-size: 1rem;
          span {
            display: none;
          }
        }
        #company {
          font-size: 0.8rem;
        }
        #social a {
          --icon_size: 1.5rem;
        }
      }
    }
  }
</style>
