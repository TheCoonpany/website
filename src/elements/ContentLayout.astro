---
interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<div data-el="content-layout" class={className}>
  <slot />
</div>

<style lang="scss">
  div {
    width: clamp(320px, 100%, 1200px);
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: grid;
    min-height: 1px;
  }
</style>
