---
interface Props {
  name: string;
  page: string;
  href: string;
}

const { name, page, href } = Astro.props;
---

<li data-to={page}>
  <a href={href}>
    <span>{name}</span>
  </a>
</li>

<style lang="scss">
  @use "./AppHeader.FolderLink.scss" as *;

  li {
    position: relative;
    margin-right: -1rem;
    height: 3.5rem;
    display: inline-block;

    a {
      display: inline-block;
      background-color: #f4e3c3;
      padding: 1rem 2rem 3rem;
      border-radius: 0.75rem 0.75rem 0 0;
      color: #111;
      transform: translatey(1.2rem);
      box-shadow: var(--shadow-3);
      text-decoration: none;
      transition:
        transform 0.2s ease-in-out 0.1s,
        rotate 0.2s ease-in-out 0.1s,
        color 0.2s ease,
        box-shadow 0.2s ease;

      &:focus,
      &:hover {
        transform: translatey(0.5rem);
        box-shadow: var(--shadow-5);
        color: #222;
        outline: none;
        rotate: 0deg;
      }

      &::before {
        content: "X";
        display: inline-block;
        margin-right: 0.75rem;
      }
    }

    @each $service, $deg in $services {
      &[data-to="#{$service}"] a {
        rotate: $deg;
      }
    }
  }
</style>

<style is:global lang="scss">
  @use "./AppHeader.FolderLink.scss" as *;

  header#app-header {
    @each $service, $deg in $services {
      &:has(~ #app-content [data-current-page="#{$service}"])
        [data-to="#{$service}"]
        a {
        color: #222;
        rotate: 0deg;
        transform: translatey(0.5rem);
        box-shadow: var(--shadow-5);
      }
    }
  }
</style>
