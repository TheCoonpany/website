---
import Legal_View from "../../views/Legal.view.astro";
import Layout from "../../layouts/Layout.astro";

import { getPageI18n } from "../../helpers/locales";

const i18n = getPageI18n(import.meta.url, "privacy_policy");
---

<Layout
  meta={{ ...i18n.locales.meta, url: Astro.url.pathname }}
  lang={i18n.lang}
>
  <Legal_View {...i18n} />
</Layout>
